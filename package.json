{
  "name": "dsh-herdr",
  "version": "0.1.0",
  "type": "module",
  "description": "Reports dsh TUI lifecycle state (idle / working / blocked) to Herdr's agent panel through the pane socket API.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node --format esm --external @deepseek-ai/cordis && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "smoke": "bun run scripts/smoke.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@types/node": "^22.20.0",
    "typescript": "^5.8.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
